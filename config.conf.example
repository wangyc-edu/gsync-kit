# ============================================================
#  gsync 配置
#  ----------------------------------------------------------
#  改完保存即可，下次同步生效。
#  改「时间」或「解锁同步」后，执行 gsync reload 重新加载定时任务。
#  不想编辑文件可以直接运行：gsync ui
# ============================================================

# 仓库目录。多个用英文逗号分隔。
# 每一项可以是「放着多个仓库的父目录」，也可以直接指向某一个仓库。
ROOTS="$HOME/Documents/gitlab"

# 每天自动同步的时间，24 小时制，多个用英文逗号分隔。
# 留空表示不启用定时同步，只保留手动与解锁触发。
TIMES="08:50,13:50"

# 解锁屏幕 / 唤醒电脑后是否顺带同步一次：1=启用，0=关闭
SYNC_ON_UNLOCK=1

# 两次「解锁触发」之间的最小间隔（分钟），避免频繁锁屏解锁来回同步。
UNLOCK_MIN_INTERVAL=60

# 从 ROOTS 往下查找 .git 的层级。
# 仓库直接放在 ROOTS 下用 2；再多一层目录（如 group/repo）用 3。
SCAN_DEPTH=2

# 报告标题与推送里显示的产品名，可改成 GitLab / Gitee / GitHub
PROVIDER_NAME="GitLab"
